# ============================================================
# Midnight Zoo - environment variables
# Copy to .env (for local dev) or set in Cloudflare Pages
# project settings -> Environment variables (for production).
#
# All VITE_ prefixed vars are baked into the client bundle at
# build time. They are NOT secret. The Storefront access token
# is designed to be exposed publicly (it has scoped read-only
# permissions on products + cart mutations).
# ============================================================

# Your Shopify store domain (do not include https://).
# Use the *.myshopify.com domain, not your custom domain.
VITE_SHOPIFY_STORE_DOMAIN=midnightzoo.myshopify.com

# Storefront API access token. Get this from your Shopify
# admin -> Apps and sales channels -> Develop apps -> create a
# private app -> API credentials -> Storefront API access tokens.
VITE_SHOPIFY_STOREFRONT_TOKEN=
